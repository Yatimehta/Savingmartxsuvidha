# ===================================================
# VegiMart × Suvidha Environment Variables Template
# ===================================================

# App Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Required for Docker/Production)
DATABASE_URL=postgresql://vegimart_admin:vegimart_secret_password@localhost:5432/vegimart_db?schema=public
POSTGRES_USER=vegimart_admin
POSTGRES_PASSWORD=vegimart_secret_password
POSTGRES_DB=vegimart_db

# ===================================================
# PAYMENT GATEWAY A: STRIPE
# ===================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51MockStripeVegiMartKey001
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_vegimart_secret
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret

# ===================================================
# PAYMENT GATEWAY B: RAZORPAY (India & International)
# ===================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_VegiMart99
RAZORPAY_KEY_SECRET=rzp_secret_mock_VegiMartSuvidha
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_mock_secret

# ===================================================
# EMAIL & NOTIFICATION SERVICE (SendGrid / Mailgun)
# ===================================================
SENDGRID_API_KEY=SG.mock_sendgrid_api_key_sample
EMAIL_FROM=orders@vegimartsuvidha.com.au

# ===================================================
# CLOUD IMAGE STORAGE (AWS S3 / Cloudinary)
# ===================================================
AWS_ACCESS_KEY_ID=AKIA_SAMPLE_KEY
AWS_SECRET_ACCESS_KEY=sample_secret_key
AWS_S3_BUCKET=vegimart-product-media
AWS_REGION=ap-southeast-2
